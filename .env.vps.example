# Copy to .env.vps on VPS; never commit actual credentials.
P076_DOMAIN=incident.example.com
P076_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
P076_ACCESS_USER=engineer
# Generate interactively with: docker run --rm -it caddy:2 caddy hash-password
# Keep bcrypt hash in single quotes to preserve literal dollar signs.
P076_ACCESS_HASH='REPLACE_WITH_BCRYPT_HASH'
VAST_SSH_HOST=REPLACE_WITH_HOST
VAST_SSH_PORT=22
VAST_SSH_USER=root
WORKER_POLL_S=30
QWEN_BATCH_FRAMES=1
QWEN_SAMPLING_FPS=4
QWEN_TIMEOUT_S=600
MAX_VIDEO_SIZE_MB=256
MAX_LOG_SIZE_MB=25

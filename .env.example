# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Cloud: enable SSL validation for the native backend.
DATABASE_CLOUD=false
# Docker cloud override reads this separate URL; keep credentials in .env only.
P076_DATABASE_URL=
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/incidentlens-ollama.db
INCIDENT_STORAGE_DIR=./backend/data/incidents
QWEN_RUNTIME=ollama
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_OLLAMA_MODEL=qwen2.5vl:7b
QWEN_PROMPT_PATH=./backend/data/promt.txt
QWEN_LOG_PROMPT_PATH=./backend/prompts/ollama_incident.txt
QWEN_OUTPUTS_PATH=./logs/qwen/outputs.txt
RUNTIME_LOG_DIR=./logs/runtime
QWEN_ARTIFACT_SUBDIR=output
QWEN_TIMEOUT_S=1800
QWEN_BATCH_FRAMES=1
QWEN_SAMPLING_FPS=4
QWEN_INFERENCE_FRAME_LIMIT=4
QWEN_CANDIDATE_MIN_ACCELERATION=8

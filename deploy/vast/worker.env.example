APP_ENV=production
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://c4-app-076.vercel.app
DATABASE_CLOUD=true
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
INCIDENT_STORAGE_DIR=/workspace/incidentlens-media
QWEN_RUNTIME=ollama
QWEN_REMOTE_OLLAMA=true
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_OLLAMA_MODEL=qwen3.5:9b
QWEN_REASONING_EFFORT=none
QWEN_VIDEO_PIPELINE=two_tier
QWEN_ARTIFACT_SUBDIR=output
QWEN_PROMPT_PATH=/workspace/incidentlens/backend/data/promt.txt
QWEN_LOG_PROMPT_PATH=/workspace/incidentlens/backend/prompts/ollama_incident.txt
QWEN_SUMMARY_PROMPT_PATH=/workspace/incidentlens/backend/prompts/video_summary.txt
QWEN_VIDEO_SUMMARY=true
QWEN_OUTPUTS_PATH=/workspace/incidentlens-logs/qwen-output.txt
RUNTIME_LOG_DIR=/workspace/incidentlens-logs/runtime
WORKER_POLL_S=10
QWEN_TIMEOUT_S=1800
# Segment count is set by MIN_PRIORITY=4 + BRAKING_CONFIRMATION_S=0.08 (1 segment each on CARLA v16-v18), not by
# the deceleration threshold. At >= 12 m/s2 v18 gets 0 segments (NOT_ANALYZED_NO_FLAGS); 6-10 all keep it.
QWEN_TRIGGER_MIN_PRIORITY=4
QWEN_TRIGGER_DECELERATION=6
QWEN_BRAKING_CONFIRMATION_S=0.08
QWEN_FLAG_ONLY=true
QWEN_TEMPORAL_CONTEXT=true
QWEN_BATCH_FRAMES=6
QWEN_TWO_STAGE=false

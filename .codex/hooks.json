{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" scripts/_pyrun.sh scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

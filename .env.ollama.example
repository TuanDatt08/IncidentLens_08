APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/incidentlens-ollama.db
INCIDENT_STORAGE_DIR=./backend/data/incidents
QWEN_RUNTIME=ollama
QWEN_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
QWEN_OLLAMA_MODEL=qwen2.5vl:7b
QWEN_PROMPT_PATH=./backend/data/promt.txt
QWEN_LOG_PROMPT_PATH=./backend/prompts/ollama_incident.txt
QWEN_OUTPUTS_PATH=./logs/qwen/outputs.txt
RUNTIME_LOG_DIR=./logs/runtime
QWEN_ARTIFACT_SUBDIR=output
QWEN_TIMEOUT_S=1800
QWEN_BATCH_FRAMES=1
QWEN_SAMPLING_FPS=4
QWEN_INFERENCE_FRAME_LIMIT=4
QWEN_CANDIDATE_MIN_ACCELERATION=8


LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

LOG_LEVEL=INFO
